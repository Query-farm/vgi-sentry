# name: test/sql/sentry.test
# description: SQL tests for the sentry worker against the strict Sentry replay server (test/mock_api/server.py)
# group: [sentry]

require vgi

require-env SENTRY_WORKER

require-env SENTRY_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'sentry' (TYPE vgi, LOCATION '{SENTRY_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM sentry.main.organizations;
----
<REGEX>:.*no sentry secret.*

statement ok
CREATE SECRET sentry_bad (TYPE sentry, AUTH_TOKEN 'sntrys_wrong', BASE_URL '{SENTRY_FIXTURE_URL}');

statement error
SELECT count(*) FROM sentry.main.organizations;
----
<REGEX>:.*HTTP 401.*Invalid token.*

statement ok
DROP SECRET sentry_bad;

statement ok
CREATE SECRET sentry_insecure (TYPE sentry, AUTH_TOKEN 'sntrys_x', BASE_URL 'http://sentry.example.com');

statement error
SELECT count(*) FROM sentry.main.organizations;
----
<REGEX>:.*https.*

statement ok
DROP SECRET sentry_insecure;

statement ok
CREATE SECRET sentry_region (TYPE sentry, AUTH_TOKEN 'sntrys_x', REGION 'eu');

statement error
SELECT count(*) FROM sentry.main.organizations;
----
<REGEX>:.*region 'eu' is not one of us, de.*

statement ok
DROP SECRET sentry_region;

# The token goes out as a Bearer header; the bad-token request was recorded as auth=bad.
query I
SELECT count(*) > 0 FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/') WHERE auth = 'bad';
----
true

# --------------------------------------------------- every organization (no default)

statement ok
CREATE SECRET sentry_all (TYPE sentry, AUTH_TOKEN 'sntrys_test_token', BASE_URL '{SENTRY_FIXTURE_URL}');

query TTTT
SELECT slug, name, status, region_url FROM sentry.main.organizations ORDER BY slug;
----
acme	Acme Corp	active	https://us.sentry.io
globex	Globex	active	https://de.sentry.io

query TT
SELECT slug, created_at FROM sentry.main.organizations WHERE require_2fa;
----
acme	2023-03-01 09:00:00+00

# Without organization := every organization is read.
query TTT
SELECT organization, slug, teams FROM sentry.main.projects() ORDER BY ALL;
----
acme	backend	[platform]
acme	frontend	[web]
acme	mobile	[mobile]
globex	web	[core]

# A pushed organization filter reads only that organization.
query T
SELECT slug FROM sentry.main.projects() WHERE organization = 'globex';
----
web

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/globex/projects/');
----
2

statement ok
DROP SECRET sentry_all;

# ------------------------------------------------------------ default organization

statement ok
CREATE SECRET sentry (TYPE sentry, AUTH_TOKEN 'sntrys_test_token', BASE_URL '{SENTRY_FIXTURE_URL}', ORGANIZATION 'acme');

query TTT
SELECT slug, platform, has_replays FROM sentry.main.projects() ORDER BY slug;
----
backend	python-django	false
frontend	javascript-react	true
mobile	android	false

# Teams: the first request answers 503 and is retried; `slug =` → query=slug:.
query TIT
SELECT slug, member_count, projects FROM sentry.main.teams() ORDER BY slug;
----
mobile	2	[mobile]
platform	4	[backend]
web	3	[frontend]

query T
SELECT slug FROM sentry.main.teams() WHERE slug = 'web';
----
web

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/teams/') WHERE query LIKE '%"query": "slug:web"%';
----
1

# Members: role / pending / has_2fa push down as member search.
query TTTT
SELECT name, role, has_2fa, team_roles FROM sentry.main.members() WHERE role = 'admin';
----
Raj Patel	admin	true	[{'team': platform, 'role': contributor}, {'team': web, 'role': admin}]

query T
SELECT email FROM sentry.main.members() WHERE NOT has_2fa AND NOT pending;
----
li@acme.example

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/members/') WHERE query LIKE '%isInvited:false%' AND query LIKE '%has2fa:false%';
----
1

query I
SELECT count(*) FROM sentry.main.members() WHERE pending AND user_id IS NULL;
----
1

query T
SELECT name FROM sentry.main.environments() ORDER BY name;
----
production
staging

query T
SELECT name FROM sentry.main.environments(visibility := 'hidden');
----
dev-local

statement error
SELECT name FROM sentry.main.environments(visibility := 'secret');
----
<REGEX>:.*visibility.*

# ------------------------------------------------------------------------ issues

# Default window 90d: MOBILE-2 (last seen July) is outside it; every status is returned
# because the worker always sends `query` (Sentry would otherwise default to is:unresolved).
# The first issues request answers 429 and is retried.
query TTTTIIT
SELECT short_id, status, substatus, level, event_count, user_count, assignee FROM sentry.main.issues() ORDER BY short_id;
----
BACKEND-1	unresolved	regressed	error	845	120	Jane Doe
BACKEND-2	unresolved	new	fatal	57	12	NULL
BACKEND-3	unresolved	ongoing	warning	410	0	platform
BACKEND-4	ignored	archived_forever	warning	12	3	NULL
FRONTEND-1	unresolved	ongoing	error	1204	311	web
FRONTEND-2	resolved	NULL	error	77	40	NULL
MOBILE-1	unresolved	escalating	fatal	3021	980	NULL

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/') WHERE query = '{"limit": "100", "query": "", "sort": "date", "statsPeriod": "90d"}';
----
2

# Incident vocabulary columns.
query TTTTT
SELECT short_id, incident_status, created_at = first_seen, url, issue_category FROM sentry.main.issues() WHERE short_id IN ('FRONTEND-1', 'BACKEND-4', 'FRONTEND-2', 'BACKEND-3') ORDER BY short_id;
----
BACKEND-3	triggered	true	https://acme.sentry.io/issues/4504005/	performance
BACKEND-4	acknowledged	true	https://acme.sentry.io/issues/4504007/	error
FRONTEND-1	triggered	true	https://acme.sentry.io/issues/4504001/	error
FRONTEND-2	resolved	true	https://acme.sentry.io/issues/4504006/	error

# status / level push down as is: / level:[...]; Sentry returns pages of 3 and the
# Link cursor is followed.
query TI
SELECT short_id, event_count FROM sentry.main.issues() WHERE status = 'unresolved' AND level IN ('error', 'fatal') ORDER BY event_count DESC;
----
MOBILE-1	3021
FRONTEND-1	1204
BACKEND-1	845
BACKEND-2	57

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/') WHERE query LIKE '%"query": "is:unresolved level:[error,fatal]"%';
----
2

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/') WHERE query LIKE '%"query": "is:unresolved level:[error,fatal]"%' AND query LIKE '%"cursor": "0:3:0"%';
----
1

# != → !level:, priority → issue.priority:, first_seen range → firstSeen:>=.
query T
SELECT short_id FROM sentry.main.issues() WHERE level <> 'warning' AND priority = 'high' AND first_seen >= TIMESTAMPTZ '2026-10-01 00:00:00+00' ORDER BY short_id;
----
BACKEND-2
FRONTEND-1
MOBILE-1

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/') WHERE query LIKE '%!level:warning issue.priority:high firstSeen:>=2026-10-01T00:00:00Z%';
----
1

# assignee IS NULL → is:unassigned; team assignment → assigned:#team; event_count → timesSeen.
query T
SELECT short_id FROM sentry.main.issues() WHERE assignee IS NULL ORDER BY short_id;
----
BACKEND-2
BACKEND-4
FRONTEND-2
MOBILE-1

query T
SELECT short_id FROM sentry.main.issues() WHERE assignee_type = 'team' AND assignee = 'platform' AND event_count > 100;
----
BACKEND-3

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/') WHERE query LIKE '%is:unassigned%' OR query LIKE '%assigned:#platform timesSeen:>=101%';
----
3

# last_seen upper bound and project_slug IN.
query T
SELECT short_id FROM sentry.main.issues() WHERE project_slug IN ('frontend', 'mobile') AND last_seen < TIMESTAMPTZ '2026-11-15 00:00:00+00';
----
FRONTEND-2

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/') WHERE query LIKE '%lastSeen:<=2026-11-15T00:00:00Z project:[frontend,mobile]%';
----
1

# Tags with spaces are quoted; the raw query is ANDed.
query T
SELECT short_id FROM sentry.main.issues(tags := ['server_name:web 2'], query := 'KeyError');
----
BACKEND-1

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/') WHERE query LIKE '%"query": "server_name:\"web 2\" KeyError"%';
----
1

# A value with a quote and a colon is escaped so Sentry's parser accepts it (strict 400 otherwise).
query I
SELECT count(*) FROM sentry.main.issues(tags := ['url:https://shop.acme.example/say "hi"']);
----
0

query T
SELECT short_id FROM sentry.main.issues(tags := ['url:https://shop.acme.example/checkout']);
----
FRONTEND-1

statement error
SELECT count(*) FROM sentry.main.issues(tags := ['no-colon']);
----
<REGEX>:.*key:value.*

# A longer window brings back MOBILE-2; project / environment / sort are request parameters.
query T
SELECT short_id FROM sentry.main.issues(stats_period := '180d', project := 'mobile', sort := 'new') ORDER BY first_seen;
----
MOBILE-2
MOBILE-1

query T
SELECT short_id FROM sentry.main.issues(environment := 'staging') ORDER BY 1;
----
BACKEND-4
FRONTEND-1

query T
SELECT short_id FROM sentry.main.issues(start_time := TIMESTAMPTZ '2026-06-01 00:00:00+00', end_time := TIMESTAMPTZ '2026-07-15 00:00:00+00');
----
MOBILE-2

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/') WHERE query LIKE '%"end": "2026-07-15T00:00:00.000Z"%' AND query LIKE '%"start": "2026-06-01T00:00:00.000Z"%' AND query NOT LIKE '%statsPeriod%';
----
1

statement error
SELECT count(*) FROM sentry.main.issues(stats_period := 'two weeks');
----
<REGEX>:.*stats_period.*

statement error
SELECT count(*) FROM sentry.main.issues(sort := 'oldest');
----
<REGEX>:.*sort.*

# ------------------------------------------------------------------ issue events

query TTTTTTT
SELECT event_id, environment, release, exception_type, handled, top_in_app_frame, user_id FROM sentry.main.issue_events(issue_id := '4504001', which := 'latest');
