frontend@3.1.0	2	2026-11-15 09:00:00+00

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/4504001/events/') WHERE query LIKE '%"environment": "production"%' AND query LIKE '%"full": "true"%';
----
2

# issue_id from a pushed IN filter; created_at range → start/end.
query TI
SELECT issue_id, count(*) FROM sentry.main.issue_events() WHERE issue_id IN ('4504001', '4504002') AND created_at >= TIMESTAMPTZ '2026-11-14 00:00:00+00' GROUP BY issue_id ORDER BY issue_id;
----
4504001	3
4504002	1

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/4504002/events/') WHERE query LIKE '%"start": "2026-11-14T00:00:00.000Z"%';
----
1

query T
SELECT list_sort(list_transform(tags, lambda t: t.key)) FROM sentry.main.issue_events(issue_id := '4504001', which := 'recommended');
