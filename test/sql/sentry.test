Ops	ops@acme.example

# --------------------------------------------------------------- audit log / usage

query TTT
SELECT event, actor, created_at FROM sentry.main.audit_log() WHERE event = 'member.invite' ORDER BY created_at;
----
member.invite	Jane Doe	2024-07-01 09:00:00+00
member.invite	Jane Doe	2026-11-12 09:00:00+00

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/audit-logs/') WHERE query LIKE '%"event": "member.invite"%';
----
1

statement error
SELECT count(*) FROM sentry.main.audit_log(organization := 'globex');
----
<REGEX>:.*audit logs are not available for organization 'globex'.*

query TTI
SELECT category, outcome, sum(quantity)::BIGINT FROM sentry.main.usage_stats() GROUP BY ALL ORDER BY ALL;
----
error	accepted	4340
error	rate_limited	30
replay	accepted	155
transaction	accepted	15500
transaction	filtered	620

query TI
SELECT reason, sum(quantity)::BIGINT FROM sentry.main.usage_stats() WHERE outcome = 'rate_limited' AND category = 'error' GROUP BY reason;
----
key_quota	30

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/stats_v2/') WHERE query LIKE '%"category": "error"%' AND query LIKE '%"outcome": "rate_limited"%' AND query LIKE '%"interval": "1d"%' AND query LIKE '%"statsPeriod": "30d"%';
----
1

query I
SELECT count(DISTINCT time) FROM sentry.main.usage_stats(interval := '1h', stats_period := '24h') WHERE category = 'transaction';
----
24

# ------------------------------------------------------------- rate limits / auth

# Every request carried the bearer token after the secret was fixed, and the 429 / 503
# answers were retried (two requests where one would have done).
query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/teams/') WHERE seq = (SELECT min(seq) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/teams/'));
----
1

query T
SELECT DISTINCT auth FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/issues/');
----
ok
