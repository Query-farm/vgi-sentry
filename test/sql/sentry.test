# ---------------------------------------------------------------------- discover

query TIR
SELECT transaction, count, p95_transaction_duration FROM sentry.main.discover('transactions', ['transaction', 'count()', 'p95(transaction.duration)'], sort := '-count()') ORDER BY count DESC;
----
GET /api/orders	5	228.0
POST /api/checkout	4	1336.4999999999995
/checkout	3	1175.0

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/events/') WHERE query = '{"dataset": "transactions", "field": ["transaction", "count()", "p95(transaction.duration)"], "per_page": "100", "sort": "-count()", "statsPeriod": "14d"}';
----
1

# Aggregate filter → having-condition; unprojected aggregate dropped, grouping field kept.
query TI
SELECT error_type, count FROM sentry.main.discover('errors', ['error.type', 'count()', 'count_unique(user.id)']) WHERE count >= 3;
----
TypeError	4

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/events/') WHERE query = '{"dataset": "errors", "field": ["error.type", "count()"], "per_page": "100", "query": "count():>=3", "statsPeriod": "14d"}';
----
1

# String filters → field:value; projection without aggregates requests only what is used.
query TR
SELECT transaction, transaction_duration FROM sentry.main.discover('transactions', ['id', 'transaction', 'transaction.duration', 'environment'], stats_period := '7d') WHERE environment = 'staging' AND transaction <> '/checkout' ORDER BY transaction_duration;
----
GET /api/orders	120.0
GET /api/orders	180.0
POST /api/checkout	300.0
POST /api/checkout	1500.0

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/events/') WHERE query LIKE '%"field": ["transaction", "transaction.duration", "environment"]%' AND query LIKE '%environment:staging%' AND query LIKE '%!transaction:/checkout%' AND query LIKE '%"statsPeriod": "7d"%';
----
2

# timestamp range → start / end; spans dataset.
query TR
SELECT span_op, sum_span_duration FROM sentry.main.discover('spans', ['span.op', 'sum(span.duration)', 'timestamp']) WHERE timestamp >= TIMESTAMPTZ '2026-11-15 00:00:00+00' AND span_op = 'db' ORDER BY timestamp;
----
db	12.5
db	3.0
db	3.4

query I
SELECT count(*) FROM read_json('{SENTRY_FIXTURE_URL}/__requests?path=/api/0/organizations/acme/events/') WHERE query LIKE '%"dataset": "spans"%' AND query LIKE '%"start": "2026-11-15T00:00:00.000Z"%' AND query LIKE '%span.op:db%';
----
1

query IT
SELECT count, last_seen FROM sentry.main.discover('errors', ['count()', 'last_seen()'], query := 'error.type:KeyError');
----
2	2026-11-14 22:00:00+00

statement error
SELECT * FROM sentry.main.discover('errors', ['count()', 'count( )']);
